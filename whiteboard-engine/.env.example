# Kreves
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...

# Kreves for den ekte håndtegningen (Nano Banana + Veo, som i Flow):
# samme Google-nøkkel som plattformen bruker til Gemini. Nøkkelen må ha
# tilgang til Veo (betalt Google-nivå).
GEMINI_API_KEY=
# Valgfritt: Veo-modellen oppdages automatisk fra nøkkelen din (ListModels),
# så du trenger vanligvis ikke sette VEO_MODEL. Sett den bare hvis du vil tvinge
# en bestemt modell. Samme med bildemodell (Nano Banana Pro).
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# VEO_MODEL=veo-3.0-generate-preview
# VEO_CLIP_SECONDS=8

# Valgfritt
PORT=3000
# Sett til det offentlige domenet der motoren kjører (brukes i svaret som videoUrl).
# La stå tomt lokalt, da brukes http://127.0.0.1:PORT.
PUBLIC_BASE_URL=
# Norsk/flerspråklig stemme fra ElevenLabs-kontoen din:
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_IMAGE_MODEL=dall-e-3
