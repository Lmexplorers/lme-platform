/hook-generator-general
  Cache-Control: no-store
/hook-generator-general.html
  Cache-Control: no-store
/baby-rhythm
  Cache-Control: no-store
/baby-rhythm.html
  Cache-Control: no-store
/lme-inntektskalkulator
  Cache-Control: no-store
/lme-inntektskalkulator.html
