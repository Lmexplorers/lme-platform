# Redigeringssider skal alltid hentes ferske, saa mobilen ikke viser en
# gammel mellomlagret versjon etter en oppdatering.
/blogg
  Cache-Control: no-store
/blogg.html
  Cache-Control: no-store
# Reel Studio oppdateres ofte og maa aldri vises fra en gammel buffer.
/reel-studio
  Cache-Control: no-store
/reel-studio.html
  Cache-Control: no-store
# Salgs- og tilbudssider maa alltid hentes ferske, saa mobilen aldri viser
# gamle priser eller loefter (f.eks. en fjernet garanti) fra buffer.
/claude-kurs
  Cache-Control: no-store
/claude-course
  Cache-Control: no-store
/funnel/claude-kurs/salg.html
  Cache-Control: no-store
/funnel/claude-kurs/mersalg.html
  Cache-Control: no-store
/funnel/tripwire/tilbud.html
  Cache-Control: no-store
# "Gjør synlig" + autopublisering: denne filen endres ofte og er lenket fra
# 147+ sider med en ?v=N cache-bust som lett glemmes å oppdatere. Uten dette
# kan mobilen kjøre en time(r)vis gammel versjon selv etter en frisk utrulling.
/js/lme-visibility.js
  Cache-Control: no-store
# Oversetteren lenkes inn uten ?v=, så en gammel mellomlagret versjon ville
# holdt engelsk tekst borte fra mobilen selv etter en fersk utrulling.
/js/i18n-auto.js
  Cache-Control: no-store
# Apper-oversikten og de nye verktøyene endres ofte rett etter lansering,
# saa de maa aldri vises fra en gammel mellomlagret versjon.
/apper
  Cache-Control: no-store
/apper.html
  Cache-Control: no-store
