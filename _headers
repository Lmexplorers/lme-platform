# Nathalie AI-chatten oppdateres nettopp for spraakbytte-feilen, og mobilen
# viste fortsatt den gamle, ufiksede versjonen etter utrullingen.
/ask-nathalie-ai
  Cache-Control: no-store
/ask-nathalie-ai.html
  Cache-Control: no-store
# LME Sosialplanlegger er ny og endres ofte akkurat naa, saa siden maa aldri
# vises fra en gammel mellomlagret versjon mens den finpusses.
/planlegger
  Cache-Control: no-store
/planlegger.html
  Cache-Control: no-store

# Kursimporten lå i samme ring tidligere 31. august 2026, og en nettleser
# som rakk å lagre den, spiller den av igjen. Derfor no-store her også.
/kurs-import
  Cache-Control: no-store
/kurs-import.html
  Cache-Control: no-store
/oppdater-kurs
  Cache-Control: no-store

# Momentum må aldri hentes fra buffer. Siden lå en kort stund bak en ring av
# omdirigeringer (se _redirects, 31. august 2026), og en 301 lagres permanent
# i Safari. Uten dette kan en nettleser som rakk å lagre ringen, fortsette å
# spille den av lenge etter at feilen er rettet.
/momentum
  Cache-Control: no-store
/momentum.html
  Cache-Control: no-store
/momentum-info
  Cache-Control: no-store
/momentum-info.html
  Cache-Control: no-store
# Tjenestesiden viser priser og leveringstider, og maa aldri vises fra en
# gammel mellomlagret versjon naar en pris eller en pakke endres.
/tjenester
  Cache-Control: no-store
/tjenester.html
  Cache-Control: no-store
# Salgssiden for engangskjopet viser pris og hva som foelger med, og maa
# aldri vises fra en gammel mellomlagret versjon.
/autopilot-app
  Cache-Control: no-store
/autopilot-app.html
  Cache-Control: no-store
# Kom i gang-veiledningen endres når leverandørenes sider endrer seg, og
# maa aldri vises fra en gammel mellomlagret versjon.
/autopilot-nokler
  Cache-Control: no-store
/autopilot-nokler.html
  Cache-Control: no-store

# Utsendingsverktoyet er kun for eier, og skal aldri ligge i en cache.
