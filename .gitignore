# Lokale backup-filer (skal ikke i repoet)
*.bak

# Node-avhengigheter (kun for lokale verktoey, ikke i repoet)
node_modules/

# Python bytekode-cache
__pycache__/
*.pyc

# Mellomsteg-HTML fra oppskrift-byggeskriptene (kun PDF-ene committes)
biblioteket/hekle/*/*_no.html
biblioteket/hekle/*/*_en.html
biblioteket/strikk/*/*_no.html
biblioteket/strikk/*/*_en.html
biblioteket/hekle/norge-rune-bottehatt/hekle_rune.html
biblioteket/hekle/norge-rune-bottehatt/hekle_rune_en.html
